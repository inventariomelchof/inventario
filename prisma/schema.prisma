generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  ALMACEN
  TIENDA
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ALMACEN)
  createdAt DateTime @default(now())
  movements KardexMovement[]
  pickLists PickList[]
accounts  Account[]
  sessions  Session[]
}
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  families Family[]
  products Product[]
}

model Family {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  internalCode String   @unique
  barcode      String?
  name         String
  description  String?
  expirationDate DateTime?

  categoryId   String
  familyId     String
  brandId      String
  category     Category @relation(fields: [categoryId], references: [id])
  family       Family   @relation(fields: [familyId], references: [id])
  brand        Brand    @relation(fields: [brandId], references: [id])
  
  unitWeight   Float
  totalWeight  Float
  stock        Int      @default(0)
  minStock     Int      @default(5)
    damagedStock Int      @default(0)
  units        ProductUnit[]
  movements    KardexMovement[]
  pickItems    PickListItem[]
  createdAt    DateTime @default(now())
}

model ProductUnit {
  id         String  @id @default(cuid())
  name       String
  multiplier Int
  price      Float
  productId  String
  product    Product @relation(fields: [productId], references: [id])
}

model PickList {
  id          String         @id @default(cuid())
  status      String         @default("PENDIENTE")
  totalWeight Float          @default(0)
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  items       PickListItem[]
  createdAt   DateTime       @default(now())
}

model PickListItem {
  id         String   @id @default(cuid())
  pickListId String
  productId  String
  pickList   PickList @relation(fields: [pickListId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  unitId     String
  quantity   Int
  weight     Float
}

model KardexMovement {
  id            String   @id @default(cuid())
  productId     String
  type          String
  quantity      Int
  previousStock Int
  newStock      Int
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  createdAt     DateTime @default(now())
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}